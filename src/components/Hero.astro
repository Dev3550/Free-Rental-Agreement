---
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 bg-gradient-to-b from-[#f8fafc] via-[#eff6ff]/60 to-[#f8fafc] border-b border-[#e2e8f0]">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#cbd5e120_1px,transparent_1px),linear-gradient(to_bottom,#cbd5e120_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Monospace Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-[#bfdbfe] text-xs font-mono text-[#1e40af] mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#1e40af] animate-pulse"></span>
      <span id="hero-country-badge" class="font-semibold tracking-wide">GLOBAL LEGAL ENGINE • 🇮🇳 INDIA SPECIFIC PRESETS</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#0f172a] max-w-4xl mx-auto leading-[1.15] mb-6">
      Create Legally Binding <br class="hidden sm:inline" />
      <span id="hero-dynamic-title" class="text-[#1e40af] underline decoration-[#bfdbfe] underline-offset-8">11-Month Tenancy Agreements</span> Online.
    </h1>

    <!-- Subtitle Description -->
    <p id="hero-dynamic-desc" class="text-base sm:text-lg text-[#475569] max-w-3xl mx-auto mb-8 font-normal leading-relaxed">
      Instant split-screen legal document builder for landlords and tenants. Customized clauses, state stamp duty calculators, digital signatures, and instant PDF download — 100% free with zero paywalls.
    </p>

    <!-- CTAs & Action Pills -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <a 
        href="#builder-section" 
        class="inline-flex items-center gap-2 text-sm font-bold bg-[#1e40af] text-white hover:bg-[#1d4ed8] px-7 py-3.5 rounded-full transition-all shadow-md active:scale-95 focus-visible:outline-none"
        id="hero-start-builder-btn"
      >
        <span>Build Your Agreement Now</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <a 
        href="#calculator-section" 
        class="inline-flex items-center gap-2 text-sm font-semibold bg-white hover:bg-[#f1f5f9] text-[#0f172a] border border-[#cbd5e1] px-6 py-3.5 rounded-full transition-all shadow-sm focus-visible:outline-none"
        id="hero-calc-duty-btn"
      >
        <svg class="w-4 h-4 text-[#1e40af]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
        <span id="hero-calc-btn-text">Check Stamp Duty Rates</span>
      </a>
    </div>

    <!-- Key Feature Badges Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-[#cbd5e1]/60">
      <div class="bg-white border border-[#e2e8f0] rounded-xl p-4 text-left shadow-sm flex items-start gap-3">
        <div class="p-2 rounded-lg bg-[#eff6ff] text-[#1e40af] shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-[#0f172a]">Live Split Preview</h4>
          <p class="text-[11px] text-[#64748b] mt-0.5">Real-time document canvas updates as you type.</p>
        </div>
      </div>

      <div class="bg-white border border-[#e2e8f0] rounded-xl p-4 text-left shadow-sm flex items-start gap-3">
        <div class="p-2 rounded-lg bg-[#ecfdf5] text-[#059669] shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-[#0f172a]">100% Lawyer Vetted</h4>
          <p class="text-[11px] text-[#64748b] mt-0.5">Compliant with state laws & rent controls.</p>
        </div>
      </div>

      <div class="bg-white border border-[#e2e8f0] rounded-xl p-4 text-left shadow-sm flex items-start gap-3">
        <div class="p-2 rounded-lg bg-[#fef3c7] text-[#b45309] shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-[#0f172a]">Digital Signatures</h4>
          <p class="text-[11px] text-[#64748b] mt-0.5">Draw or type e-signatures right in contract.</p>
        </div>
      </div>

      <div class="bg-white border border-[#e2e8f0] rounded-xl p-4 text-left shadow-sm flex items-start gap-3">
        <div class="p-2 rounded-lg bg-[#f3e8ff] text-[#7e22ce] shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-[#0f172a]">Instant PDF Export</h4>
          <p class="text-[11px] text-[#64748b] mt-0.5">Download or print clean formatted A4 agreement.</p>
        </div>
      </div>
    </div>
  </div>
</section>
