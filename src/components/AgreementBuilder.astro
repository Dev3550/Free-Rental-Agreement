---
---

<section id="builder-section" class="py-12 md:py-16 bg-[#f8fafc] min-h-screen relative border-b border-[#e2e8f0]">
  <div class="max-w-[1550px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Active Contract Indicator -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[#1e40af] mb-1 font-semibold">
          <span>[STEP-BY-STEP BUILDER]</span>
          <span>•</span>
          <span id="active-category-tag">CATEGORY: RESIDENTIAL RENTAL AGREEMENT</span>
          <span>•</span>
          <span id="active-jurisdiction-tag">INR JURISDICTION</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#0f172a]" id="builder-main-heading">
          Interactive Residential Agreement Canvas
        </h2>
        <p class="text-sm text-[#475569] mt-1">
          Fill out the fields on the left. Watch your country-specific legal document format live on the right.
        </p>
      </div>

      <!-- Toolbar Actions & Sample Data Button -->
      <div class="flex items-center gap-2 flex-wrap">
        <button 
          id="btn-fill-sample" 
          type="button"
          class="inline-flex items-center gap-1.5 text-xs font-bold bg-[#1e40af] hover:bg-[#1d4ed8] text-white px-4 py-2.5 rounded-xl transition-colors shadow-sm focus-visible:outline-none"
        >
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          <span>Fill Country Sample Data</span>
        </button>

        <button 
          id="btn-clear-fields" 
          type="button"
          class="inline-flex items-center gap-1.5 text-xs font-semibold bg-white hover:bg-[#f1f5f9] text-[#64748b] hover:text-[#0f172a] border border-[#cbd5e1] px-3.5 py-2.5 rounded-xl transition-colors focus-visible:outline-none"
        >
          <span>Reset Form</span>
        </button>
      </div>
    </div>

    <!-- Main Split Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT PANEL: FORM WIZARD (5 Cols on LG) -->
      <div class="lg:col-span-5 bg-white border border-[#e2e8f0] rounded-2xl p-5 sm:p-6 shadow-md sticky top-20 max-h-[calc(100vh-100px)] overflow-y-auto">
        
        <!-- Step Navigation Pills -->
        <div class="flex items-center justify-between border-b border-[#e2e8f0] pb-4 mb-6 gap-1 overflow-x-auto" id="wizard-steps-container" role="tablist">
          <button type="button" data-step="1" class="wizard-step-tab active text-xs font-bold px-3 py-1.5 rounded-lg transition-all bg-[#1e40af] text-white shrink-0 shadow-sm" role="tab" aria-selected="true">
            1. Parties
          </button>
          <button type="button" data-step="2" class="wizard-step-tab text-xs font-medium px-3 py-1.5 rounded-lg transition-all text-[#64748b] hover:text-[#0f172a] bg-[#f1f5f9] shrink-0" role="tab" aria-selected="false">
            2. Location & Zip
          </button>
          <button type="button" data-step="3" class="wizard-step-tab text-xs font-medium px-3 py-1.5 rounded-lg transition-all text-[#64748b] hover:text-[#0f172a] bg-[#f1f5f9] shrink-0" role="tab" aria-selected="false">
            3. Financials & Dates
          </button>
          <button type="button" data-step="4" class="wizard-step-tab text-xs font-medium px-3 py-1.5 rounded-lg transition-all text-[#64748b] hover:text-[#0f172a] bg-[#f1f5f9] shrink-0" role="tab" aria-selected="false">
            4. Clauses & Rules
          </button>
        </div>

        <form id="agreement-form" onsubmit="event.preventDefault();" class="space-y-6">
          
          <!-- STEP 1: PARTY DETAILS -->
          <div id="step-content-1" class="wizard-step-panel space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider font-mono text-xs flex items-center gap-2 border-b border-[#222222] pb-2">
              <span class="w-5 h-5 rounded-full bg-[#0070f3] text-white flex items-center justify-center text-[10px]">1</span>
              <span id="title-step-1">Party Information</span>
            </h3>

            <!-- Party 1 (Landlord / Client / Owner) -->
            <div class="space-y-3 bg-[#161616] p-3.5 rounded-xl border border-[#222222]">
              <h4 class="text-xs font-medium text-[#50e3c2] uppercase tracking-wide" id="label-party-1-header">First Part (Lessor / Landlord)</h4>
              <div>
                <label for="landlord_name" class="block text-xs text-[#a1a1a1] mb-1" id="label-party-1-name">Full Legal Name *</label>
                <input type="text" id="landlord_name" name="landlord_name" placeholder="e.g. Rajesh Kumar Sharma" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <div>
                  <label for="landlord_id" class="block text-xs text-[#a1a1a1] mb-1" id="label-landlord-id">ID Number *</label>
                  <input type="text" id="landlord_id" name="landlord_id" placeholder="ID Number..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="landlord_phone" class="block text-xs text-[#a1a1a1] mb-1">Contact Phone</label>
                  <input type="tel" id="landlord_phone" name="landlord_phone" placeholder="Phone number..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
                </div>
              </div>

              <div>
                <label for="landlord_address" class="block text-xs text-[#a1a1a1] mb-1" id="label-party-1-address">Full Address</label>
                <input type="text" id="landlord_address" name="landlord_address" placeholder="Residential address..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
              </div>
            </div>

            <!-- Party 2 (Tenant / Lessee / Contractor) -->
            <div class="space-y-3 bg-[#161616] p-3.5 rounded-xl border border-[#222222]">
              <h4 class="text-xs font-medium text-[#7928ca] uppercase tracking-wide" id="label-party-2-header">Second Part (Lessee / Tenant)</h4>
              <div>
                <label for="tenant_name" class="block text-xs text-[#a1a1a1] mb-1" id="label-party-2-name">Full Legal Name *</label>
                <input type="text" id="tenant_name" name="tenant_name" placeholder="e.g. Vikramaditya Roy" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <div>
                  <label for="tenant_id" class="block text-xs text-[#a1a1a1] mb-1" id="label-tenant-id">ID Number *</label>
                  <input type="text" id="tenant_id" name="tenant_id" placeholder="ID Number..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
                </div>
                <div>
                  <label for="tenant_phone" class="block text-xs text-[#a1a1a1] mb-1">Contact Phone</label>
                  <input type="tel" id="tenant_phone" name="tenant_phone" placeholder="Phone number..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
                </div>
              </div>

              <div>
                <label for="tenant_permanent_address" class="block text-xs text-[#a1a1a1] mb-1" id="label-party-2-address">Permanent Address</label>
                <input type="text" id="tenant_permanent_address" name="tenant_permanent_address" placeholder="Permanent address..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors" />
              </div>
            </div>
          </div>

          <!-- STEP 2: LOCATION & SMART ZIP CODE LOOKUP -->
          <div id="step-content-2" class="wizard-step-panel hidden space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider font-mono text-xs flex items-center gap-2 border-b border-[#222222] pb-2">
              <span class="w-5 h-5 rounded-full bg-[#0070f3] text-white flex items-center justify-center text-[10px]">2</span>
              Location & Smart ZIP Code Auto-Lookup
            </h3>

            <!-- Smart Zip Code Lookup Box -->
            <div class="bg-[#161616] p-3.5 rounded-xl border border-[#0070f3]/40 space-y-2">
              <label for="zip_code_input" class="block text-xs font-semibold text-[#50e3c2] flex items-center justify-between">
                <span>⚡ Postal / ZIP Code Auto-Lookup</span>
                <span class="text-[10px] text-[#888888] font-mono">Auto-detects State & Rules</span>
              </label>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="zip_code_input" 
                  name="zip_code_input" 
                  placeholder="e.g. 400001 (IN) / 90210 (US) / W1A (UK) / 00000 (UAE)" 
                  class="w-full bg-[#0a0a0a] text-xs font-mono text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none" 
                />
                <button type="button" id="btn-zip-lookup" class="bg-[#0070f3] hover:bg-[#0060d0] text-white text-xs font-semibold px-3 py-2 rounded-lg shrink-0">
                  Lookup
                </button>
              </div>
              <div id="zip-lookup-badge" class="text-[11px] font-mono text-[#a1a1a1] hidden">
                Detected: <span id="zip-detected-state" class="text-white font-bold">Maharashtra</span>
              </div>
            </div>

            <div>
              <label for="property_address" class="block text-xs text-[#a1a1a1] mb-1" id="label-property-address">Full Address / Work Location *</label>
              <textarea id="property_address" name="property_address" rows="2" placeholder="Full property, site or office address..." class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors"></textarea>
            </div>

            <!-- WORK TYPE & PURPOSE OF CONTRACT (SPECIFIC SCOPE OF WORK) -->
            <div class="space-y-3 bg-[#161616] p-3.5 rounded-xl border border-[#0070f3]/30">
              <h4 class="text-xs font-semibold text-[#50e3c2] uppercase tracking-wide flex items-center justify-between">
                <span>🛠️ Contract Work Type & Purpose</span>
                <span class="text-[10px] text-[#888888] font-mono">Scope of Agreement</span>
              </h4>

              <div>
                <label for="work_type_input" class="block text-xs text-[#a1a1a1] mb-1 font-medium" id="label-work-type">Nature / Category of Contract Work *</label>
                <input 
                  type="text" 
                  id="work_type_input" 
                  name="work_type_input" 
                  placeholder="e.g. Roof Repair & Waterproofing / Software Engineering / Sublease" 
                  value="Residential Tenancy / Lease Agreement"
                  class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-semibold" 
                />
              </div>

              <div>
                <label for="work_scope_description" class="block text-xs text-[#a1a1a1] mb-1 font-medium" id="label-work-scope">Specific Work Description & Contract Purpose (Kya Kaam Karna H) *</label>
                <textarea 
                  id="work_scope_description" 
                  name="work_scope_description" 
                  rows="3" 
                  placeholder="Describe exact work details, purpose of contract, materials, or lease terms..." 
                  class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none transition-colors leading-relaxed"
                >Leasing of residential premises for personal family accommodation along with fixture & fittings as per agreed terms.</textarea>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="property_type" class="block text-xs text-[#a1a1a1] mb-1" id="label-property-type">Sub-Category</label>
                <select id="property_type" name="property_type" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none">
                  <option value="Residential Flat / Apartment" selected>Residential Flat / Apartment</option>
                  <option value="Independent House / Villa">Independent House / Villa</option>
                  <option value="Commercial Shop / Retail Outlet">Commercial Shop / Retail Outlet</option>
                  <option value="Corporate Office Space">Corporate Office Space</option>
                  <option value="PG / Roommate Single Room">PG / Roommate Single Room</option>
                  <option value="Software / Design Consulting Services">Software / Design Services</option>
                  <option value="Civil Construction Work">Civil Construction Work</option>
                  <option value="Interior Fitting & Decor Work">Interior Fitout Work</option>
                  <option value="Roofing Repair & Waterproofing">Roofing Repair Work</option>
                  <option value="Property Sublease & Room Share">Property Sublease</option>
                  <option value="Power of Attorney Authorization">Power of Attorney</option>
                  <option value="Non-Disclosure & Confidentiality">NDA Confidentiality</option>
                  <option value="Custom Legal Deed Agreement">Custom Legal Deed</option>
                </select>
              </div>

              <div>
                <label for="state_jurisdiction" class="block text-xs text-[#a1a1a1] mb-1" id="label-jurisdiction">State / Region Jurisdiction</label>
                <select id="state_jurisdiction" name="state_jurisdiction" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono text-xs">
                  <option value="Maharashtra" selected>Maharashtra</option>
                  <option value="Karnataka">Karnataka</option>
                  <option value="Delhi NCR">Delhi NCR</option>
                  <option value="Tamil Nadu">Tamil Nadu</option>
                  <option value="Telangana">Telangana</option>
                  <option value="Uttar Pradesh">Uttar Pradesh</option>
                  <option value="California (US)">California (US)</option>
                  <option value="Texas (US)">Texas (US)</option>
                  <option value="New York (US)">New York (US)</option>
                  <option value="Florida (US)">Florida (US)</option>
                  <option value="London (UK)">London (UK)</option>
                  <option value="Dubai (UAE)">Dubai (UAE)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- STEP 3: FINANCIALS & DATES -->
          <div id="step-content-3" class="wizard-step-panel hidden space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider font-mono text-xs flex items-center gap-2 border-b border-[#222222] pb-2">
              <span class="w-5 h-5 rounded-full bg-[#0070f3] text-white flex items-center justify-center text-[10px]">3</span>
              Financial Consideration & Custom Duration
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="lease_start_date" class="block text-xs text-[#a1a1a1] mb-1">Contract Start Date *</label>
                <input type="date" id="lease_start_date" name="lease_start_date" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none" />
              </div>

              <div>
                <label for="lease_tenure_months" class="block text-xs text-[#a1a1a1] mb-1">Custom Duration (Months) *</label>
                <input type="number" id="lease_tenure_months" name="lease_tenure_months" value="11" min="1" max="120" placeholder="11" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="monthly_rent" class="block text-xs text-[#a1a1a1] mb-1" id="label-monthly-rent">Monthly Consideration (<span class="currency-symbol">₹</span>) *</label>
                <input type="number" id="monthly_rent" name="monthly_rent" placeholder="25000" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono" />
              </div>

              <div>
                <label for="security_deposit" class="block text-xs text-[#a1a1a1] mb-1" id="label-security-deposit">Security Deposit / Advance (<span class="currency-symbol">₹</span>) *</label>
                <input type="number" id="security_deposit" name="security_deposit" placeholder="100000" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="rent_due_day" class="block text-xs text-[#a1a1a1] mb-1">Monthly Payment Due Date</label>
                <select id="rent_due_day" name="rent_due_day" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono">
                  <option value="1st" selected>1st of every month</option>
                  <option value="5th">5th of every month</option>
                  <option value="7th">7th of every month</option>
                  <option value="10th">10th of every month</option>
                </select>
              </div>

              <div>
                <label for="notice_period" class="block text-xs text-[#a1a1a1] mb-1">Notice Period (Days)</label>
                <select id="notice_period" name="notice_period" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none font-mono">
                  <option value="30" selected>30 Days (1 Month)</option>
                  <option value="60">60 Days (2 Months)</option>
                  <option value="90">90 Days (3 Months)</option>
                </select>
              </div>
            </div>

            <div>
              <label for="maintenance_split" class="block text-xs text-[#a1a1a1] mb-1">Maintenance / Operational Charges</label>
              <select id="maintenance_split" name="maintenance_split" class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none text-xs">
                <option value="Tenant pays actual society maintenance charges directly" selected>Tenant pays maintenance directly</option>
                <option value="Included in monthly rent (Landlord responsibility)">Included in monthly rent</option>
                <option value="Split 50-50 between Landlord & Tenant">Split 50-50 between Landlord & Tenant</option>
              </select>
            </div>
          </div>

          <!-- STEP 4: CUSTOM CLAUSES & EXTRA RULES -->
          <div id="step-content-4" class="wizard-step-panel hidden space-y-4">
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider font-mono text-xs flex items-center gap-2 border-b border-[#222222] pb-2">
              <span class="w-5 h-5 rounded-full bg-[#0070f3] text-white flex items-center justify-center text-[10px]">4</span>
              Special Clauses & Custom Rules
            </h3>

            <div class="space-y-3 bg-[#161616] p-3.5 rounded-xl border border-[#222222]">
              <div class="flex items-center justify-between">
                <label for="clause_pets" class="text-xs text-white cursor-pointer">Pet Policy</label>
                <input type="checkbox" id="clause_pets" name="clause_pets" class="w-4 h-4 rounded bg-[#0a0a0a] border-[#262626] text-[#0070f3] focus:ring-0" checked />
              </div>

              <div class="border-t border-[#222222] pt-2 flex items-center justify-between">
                <label for="clause_painting" class="text-xs text-white cursor-pointer">Painting / Renovation Deduction</label>
                <input type="checkbox" id="clause_painting" name="clause_painting" class="w-4 h-4 rounded bg-[#0a0a0a] border-[#262626] text-[#0070f3] focus:ring-0" checked />
              </div>

              <div class="border-t border-[#222222] pt-2 flex items-center justify-between">
                <label for="clause_subletting" class="text-xs text-white cursor-pointer">Strict No Subletting Rule</label>
                <input type="checkbox" id="clause_subletting" name="clause_subletting" class="w-4 h-4 rounded bg-[#0a0a0a] border-[#262626] text-[#0070f3] focus:ring-0" checked />
              </div>
            </div>

            <!-- EXTRA CUSTOM CLAUSES ADDER -->
            <div class="space-y-3 bg-[#161616] p-3.5 rounded-xl border border-[#222222]">
              <h4 class="text-xs font-semibold text-[#50e3c2] uppercase tracking-wide flex items-center justify-between">
                <span>+ Add Extra Custom Clauses</span>
                <span class="text-[10px] text-[#888888] font-mono">Appends to Document</span>
              </h4>

              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="custom-clause-input" 
                  placeholder="e.g. Tenant shall not make any major modifications..." 
                  class="w-full bg-[#0a0a0a] text-xs text-white border border-[#262626] rounded-lg px-3 py-2 focus:border-[#0070f3] focus:outline-none"
                />
                <button 
                  type="button" 
                  id="btn-add-custom-clause" 
                  class="bg-[#0070f3] hover:bg-[#0060d0] text-white text-xs font-semibold px-3 py-2 rounded-lg shrink-0"
                >
                  Add Clause
                </button>
              </div>

              <div id="custom-clauses-list" class="space-y-2 pt-2"></div>
            </div>

            <!-- Signature Action Buttons -->
            <div class="pt-2 flex flex-col gap-2">
              <button 
                type="button" 
                id="btn-open-signature-modal" 
                class="w-full py-2.5 px-4 bg-gradient-to-r from-[#0070f3] to-[#7928ca] hover:opacity-90 text-white font-medium text-xs rounded-xl transition-all shadow-md flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                <span>Add Digital E-Signatures</span>
              </button>
            </div>
          </div>

          <!-- Wizard Panel Controls -->
          <div class="flex items-center justify-between pt-4 border-t border-[#222222]">
            <button type="button" id="wizard-prev-btn" class="text-xs font-medium text-[#888888] hover:text-white px-3 py-2 rounded-lg bg-[#181818] hidden">
              ← Previous Step
            </button>
            <button type="button" id="wizard-next-btn" class="ml-auto text-xs font-semibold text-black bg-white hover:bg-[#e0e0e0] px-4 py-2 rounded-lg transition-all">
              Next Step →
            </button>
          </div>
        </form>
      </div>

      <!-- RIGHT PANEL: LIVE LEGAL DOCUMENT CANVAS (7 Cols on LG) -->
