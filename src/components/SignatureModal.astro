---
---

<!-- Digital Signature Modal Overlay -->
<div id="signature-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4" aria-modal="true" role="dialog" aria-labelledby="modal-signature-title">
  <div class="bg-[#121212] border border-[#262626] rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-5 animate-in fade-in zoom-in-95 duration-150">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-[#222222] pb-3">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        <h3 class="text-base font-semibold text-white" id="modal-signature-title">Digital Signature Pad</h3>
      </div>

      <button id="btn-close-signature-modal" type="button" class="text-[#888888] hover:text-white p-1 rounded-lg hover:bg-[#1a1a1a]" aria-label="Close modal">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Target Signer Switcher (Landlord vs Tenant) -->
    <div class="flex rounded-lg bg-[#0a0a0a] p-1 border border-[#222222]">
      <button id="tab-sign-landlord" type="button" class="flex-1 py-1.5 text-xs font-semibold rounded-md bg-white text-black transition-all">
        Landlord / Lessor Signature
      </button>
      <button id="tab-sign-tenant" type="button" class="flex-1 py-1.5 text-xs font-medium rounded-md text-[#888888] hover:text-white transition-all">
        Tenant / Lessee Signature
      </button>
    </div>

    <!-- Mode Switcher (Draw vs Type) -->
    <div class="flex items-center gap-4 text-xs text-[#a1a1a1]">
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="sig_mode" value="draw" checked class="text-[#0070f3] focus:ring-0" />
        <span>Draw with Mouse/Touch</span>
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="radio" name="sig_mode" value="type" class="text-[#0070f3] focus:ring-0" />
        <span>Type Cursive Name</span>
      </label>
    </div>

    <!-- Draw Signature Canvas -->
    <div id="sig-draw-container" class="bg-white rounded-xl p-2 border border-gray-300 relative">
      <canvas id="signature-canvas" width="440" height="150" class="w-full h-36 border border-dashed border-gray-300 rounded cursor-crosshair touch-none bg-white"></canvas>
      <div class="flex justify-between items-center mt-2 px-1">
        <span class="text-[10px] text-gray-500 font-mono">Sign inside the box above</span>
        <button id="btn-clear-canvas" type="button" class="text-xs text-red-600 hover:underline">Clear Canvas</button>
      </div>
    </div>

    <!-- Type Signature Input -->
    <div id="sig-type-container" class="hidden space-y-3">
      <input type="text" id="sig-typed-input" placeholder="Enter Full Name..." class="w-full bg-[#0a0a0a] text-sm text-white border border-[#262626] rounded-xl px-3 py-2 focus:border-[#0070f3] focus:outline-none" />
      <div class="p-4 bg-white rounded-xl text-center">
        <span id="sig-type-preview" class="font-['Dancing_Script'] text-2xl text-blue-900 font-semibold">Your Typed Signature</span>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="flex items-center justify-end gap-3 pt-3 border-t border-[#222222]">
      <button id="btn-cancel-signature" type="button" class="text-xs font-medium text-[#888888] hover:text-white px-4 py-2 rounded-lg bg-[#181818]">
        Cancel
      </button>
      <button id="btn-apply-signature" type="button" class="text-xs font-semibold text-black bg-white hover:bg-[#e0e0e0] px-5 py-2 rounded-lg shadow-md transition-all">
        Apply Signature to Document
      </button>
    </div>
  </div>
</div>
