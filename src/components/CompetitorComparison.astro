            <tr class="hover:bg-[#f8fafc] transition-colors">
              <td class="p-4 sm:p-5 font-bold text-[#0f172a]">Live Real-Time Document Canvas</td>
              <td class="p-4 sm:p-5 font-semibold bg-[#eff6ff]/40 text-[#059669]">
                ✓ Instant Side-by-Side Live Preview
              </td>
