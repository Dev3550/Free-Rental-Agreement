---
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/95 border-b border-[#e2e8f0] shadow-sm transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group focus-visible:ring-2 focus-visible:ring-[#1e40af] focus-visible:outline-none rounded-md px-1 py-0.5" id="brand-logo-link">
      <div class="w-8 h-8 rounded-lg bg-[#1e40af] text-white p-[1px] flex items-center justify-center shadow-sm group-hover:bg-[#1d4ed8] transition-colors">
        <div class="w-full h-full rounded-[7px] flex items-center justify-center">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-[#0f172a] flex items-center gap-1">
          FreeRentalAgreement<span class="text-xs text-[#1e40af] font-mono font-semibold">.com</span>
        </span>
        <span class="text-[10px] text-[#64748b] tracking-wider uppercase font-mono hidden sm:inline-block">Legal Document Generator</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 bg-[#f1f5f9] border border-[#cbd5e1] rounded-full px-3 py-1 shadow-inner" aria-label="Main Navigation">
      <a href="/" class="text-xs text-[#334155] hover:text-[#1e40af] px-3 py-1 rounded-full transition-colors font-semibold hover:bg-white focus-visible:outline-none">
        Home
      </a>
      <div class="relative group">
        <button type="button" class="text-xs text-[#334155] group-hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold flex items-center gap-1 hover:bg-white">
          <span>Contracts</span>
          <svg class="w-3 h-3 text-[#64748b]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute left-0 top-full mt-2 w-64 bg-white border border-[#e2e8f0] rounded-xl p-2 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
          <a href="/residential-rental-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">🏠 Residential Rental</a>
          <a href="/rental-application" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">📋 Rental Application Form</a>
          <a href="/commercial-lease-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">🏢 Commercial Lease</a>
          <a href="/freelancer-service-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">💻 Freelancer & Service</a>
          <a href="/civil-contractor-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">🏗️ Civil Contractor</a>
          <a href="/interior-contractor-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">🎨 Interior Contractor</a>
          <a href="/roofing-contractor-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">🛠️ Roofing Contractor</a>
          <a href="/custom-legal-agreement" class="block px-3 py-2 text-xs text-[#334155] hover:bg-[#f1f5f9] hover:text-[#1e40af] rounded-lg transition-colors font-medium">📜 Custom Agreement</a>
        </div>
      </div>
      <a href="/india" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        🇮🇳 India
      </a>
      <a href="/usa" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        🇺🇸 USA
      </a>
      <a href="/uk" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        🇬🇧 UK
      </a>
      <a href="/uae" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        🇦🇪 UAE
      </a>
      <a href="/builder" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        Builder
      </a>
      <a href="/calculator" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        Calculator
      </a>
      <a href="/faq" class="text-xs text-[#334155] hover:text-[#1e40af] px-2.5 py-1 rounded-full transition-colors font-semibold hover:bg-white">
        FAQ
      </a>
    </nav>

    <!-- Right Controls: Country, Language & Mobile Hamburger -->
    <div class="flex items-center gap-2">
      
      <!-- Language Selector -->
      <div class="relative" id="lang-switcher-wrapper">
        <label for="global-lang-select" class="sr-only">Select Language</label>
        <select 
          id="global-lang-select" 
          class="appearance-none bg-[#f1f5f9] hover:bg-[#e2e8f0] text-xs font-mono text-[#0f172a] border border-[#cbd5e1] rounded-full px-2.5 py-1.5 pr-6 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#1e40af] transition-colors shadow-sm font-semibold"
          aria-label="Select Language"
        >
          <option value="EN" selected>🌐 EN</option>
          <option value="ES">🇪🇸 ES</option>
          <option value="HI">🇮🇳 HI</option>
        </select>
        <div class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[#64748b]">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>

      <!-- Country Selector -->
      <div class="relative hidden sm:block" id="country-switcher-wrapper">
        <label for="global-country-select" class="sr-only">Select Country</label>
        <select 
          id="global-country-select" 
          class="appearance-none bg-[#f1f5f9] hover:bg-[#e2e8f0] text-xs font-mono text-[#0f172a] border border-[#cbd5e1] rounded-full px-3 py-1.5 pr-7 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#1e40af] transition-colors shadow-sm font-semibold"
          aria-label="Select Country"
        >
          <option value="IN" selected>🇮🇳 India (INR)</option>
          <option value="US">🇺🇸 USA (USD)</option>
          <option value="UK">🇬🇧 UK (GBP)</option>
          <option value="UAE">🇦🇪 UAE (AED)</option>
          <option value="CA">🇨🇦 Canada (CAD)</option>
          <option value="AU">🇦🇺 Australia (AUD)</option>
          <option value="IE">🇮🇪 Ireland (EUR)</option>
          <option value="NZ">🇳🇿 New Zealand (NZD)</option>
          <option value="ES">🇪🇸 Español / Spain</option>
        </select>
        <div class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-[#64748b]">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>

      <!-- Primary Build CTA Button -->
      <a 
        href="/builder" 
        class="inline-flex items-center gap-1.5 text-xs font-bold bg-[#1e40af] text-white hover:bg-[#1d4ed8] px-3.5 py-1.5 rounded-full transition-all duration-150 shadow-md active:scale-95 focus-visible:outline-none"
        id="header-create-agreement-btn"
      >
        <span>Build Draft</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>

      <!-- Mobile Navigation Hamburger Button -->
      <button 
        type="button" 
        id="mobile-menu-toggle"
        class="lg:hidden p-2 rounded-lg text-[#334155] hover:bg-[#f1f5f9] focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-t border-[#e2e8f0] bg-white px-4 pt-3 pb-6 space-y-2 shadow-lg">
    <a href="/" class="block px-3 py-2 rounded-lg text-sm font-semibold text-[#0f172a] hover:bg-[#f1f5f9]">Home</a>
    <div class="py-1">
      <span class="block px-3 text-[11px] font-mono text-[#64748b] uppercase tracking-wider">Contracts Directory</span>
      <div class="grid grid-cols-2 gap-1 mt-1">
        <a href="/residential-rental-agreement" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">🏠 Residential Lease</a>
        <a href="/rental-application" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">📋 Rental Application</a>
        <a href="/commercial-lease-agreement" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">🏢 Commercial Lease</a>
        <a href="/freelancer-service-agreement" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">💻 Freelancer Work</a>
        <a href="/civil-contractor-agreement" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">🏗️ Civil Work</a>
        <a href="/custom-legal-agreement" class="px-3 py-1.5 text-xs text-[#334155] hover:bg-[#f1f5f9] rounded-md font-medium">📜 Custom Deed</a>
      </div>
    </div>
    <div class="pt-2 border-t border-[#e2e8f0]">
      <span class="block px-3 text-[11px] font-mono text-[#64748b] uppercase tracking-wider mb-1">Target Country Pages</span>
      <div class="grid grid-cols-3 gap-1.5 text-center">
        <a href="/india" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇮🇳 India</a>
        <a href="/usa" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇺🇸 USA</a>
        <a href="/uk" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇬🇧 UK</a>
        <a href="/uae" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇦🇪 UAE</a>
        <a href="/canada" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇨🇦 Canada</a>
        <a href="/australia" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇦🇺 Australia</a>
        <a href="/ireland" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇮🇪 Ireland</a>
        <a href="/new-zealand" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇳🇿 New Zealand</a>
        <a href="/es" class="px-2 py-1.5 bg-[#f1f5f9] hover:bg-[#e2e8f0] rounded-lg text-xs font-semibold text-[#0f172a]">🇪🇸 España</a>
      </div>
    </div>
  </div>
</header>

<script>
  document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu-drawer')?.classList.toggle('hidden');
  });
</script>
