---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategorySelector from '../components/CategorySelector.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Free Rental Agreement Templates & Downloadable Forms (USA, UK, Canada, Australia, India)"
  description="Download free residential lease agreement templates, Ontario standard lease PDF, General tenancy agreement form 18a Australia, California month-to-month lease, Texas PDF, and UK AST forms."
>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-12 md:py-16 bg-[#0a0a0a] border-b border-[#262626] relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#181818] border border-[#262626] text-xs font-mono text-[#50e3c2] mb-4">
          <span>GLOBAL CONTRACT TEMPLATE DIRECTORY</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 max-w-4xl mx-auto">
          Free Rental Agreement Forms & Lease Templates
        </h1>
        <p class="text-base sm:text-lg text-[#a1a1a1] max-w-3xl mx-auto leading-relaxed mb-8">
          Instant printable rental lease agreement forms in PDF & Doc. State-compliant lease agreement templates for USA, UK, Canada, Australia, India, and UAE.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="/builder" class="px-6 py-3 rounded-xl bg-white text-black font-semibold text-sm hover:bg-[#e0e0e0] transition-colors shadow-lg flex items-center gap-2">
            Create Free Agreement Now →
          </a>
          <a href="/calculator" class="px-6 py-3 rounded-xl bg-[#181818] text-white font-medium text-sm border border-[#262626] hover:bg-[#222222] transition-colors flex items-center gap-2">
            Stamp Duty & Tax Calculator →
          </a>
        </div>
      </div>
    </section>

    <!-- Global Template Cards Matrix -->
    <section class="py-12 bg-[#0c0c0c] border-b border-[#262626]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2">Browse State & Country Specific Rental Forms</h2>
          <p class="text-sm text-[#a1a1a1]">Select your jurisdiction for 100% compliant statutory contract clauses.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Card 1: Canada & Ontario Standard Lease -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#0070f3] transition-all">
            <div class="text-2xl mb-3">🇨🇦</div>
            <h3 class="text-lg font-bold text-white mb-2">Residential Tenancy Agreement Canada</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              Official **Ontario standard lease form PDF** compliant with the Residential Tenancies Act, 2006. Mandatory standard lease form for landlords across Ontario, BC, and Alberta.
            </p>
            <a href="/builder" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0070f3] hover:underline">
              Generate Ontario Standard Lease →
            </a>
          </div>

          <!-- Card 2: Australia & Form 18a -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#50e3c2] transition-all">
            <div class="text-2xl mb-3">🇦🇺</div>
            <h3 class="text-lg font-bold text-white mb-2">Residential Tenancy Agreement Template Australia</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              Includes **General tenancy agreement form 18a** for Queensland (RTA), NSW Fair Trading residential tenancy agreements, and Victoria Consumer Affairs tenancy forms.
            </p>
            <a href="/builder" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#50e3c2] hover:underline">
              Generate Australia Form 18a →
            </a>
          </div>

          <!-- Card 3: California Lease Agreements -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#7928ca] transition-all">
            <div class="text-2xl mb-3">🇺🇸</div>
            <h3 class="text-lg font-bold text-white mb-2">California Rental Agreement Template</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              Includes **California month to month rental agreement template** and fixed-term lease agreements compliant with AB 12 (2x rent security deposit cap) and Civil Code Sec 1940.
            </p>
            <a href="/usa" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#7928ca] hover:underline">
              California Rental Agreement PDF →
            </a>
          </div>

          <!-- Card 4: Texas & Florida Leases -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#f5a623] transition-all">
            <div class="text-2xl mb-3">🇺🇸</div>
            <h3 class="text-lg font-bold text-white mb-2">Texas & Florida Landlord Tenant Forms</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              **Texas residential lease agreement pdf** under Texas Property Code Title 8, and **Florida landlord tenant agreement form** compliant with Florida Statutes Chapter 83.
            </p>
            <a href="/usa" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#f5a623] hover:underline">
              Texas & Florida Lease PDF →
            </a>
          </div>

          <!-- Card 5: UK AST Tenancy Agreement -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#eb367f] transition-all">
            <div class="text-2xl mb-3">🇬🇧</div>
            <h3 class="text-lg font-bold text-white mb-2">Assured Shorthold Tenancy (AST) UK</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              **Tenancy agreement form UK free** under the Housing Act 1988 & Tenant Fees Act 2019. Includes statutory 5-week deposit cap and TDS deposit scheme rules.
            </p>
            <a href="/uk" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#eb367f] hover:underline">
              UK AST Tenancy Agreement →
            </a>
          </div>

          <!-- Card 6: Simple 1-Page & Commercial Forms -->
          <div class="bg-[#141414] border border-[#262626] rounded-2xl p-6 hover:border-[#0070f3] transition-all">
            <div class="text-2xl mb-3">📄</div>
            <h3 class="text-lg font-bold text-white mb-2">Simple 1 Page Lease Agreement Doc</h3>
            <p class="text-xs text-[#a1a1a1] mb-4 leading-relaxed">
              Minimalist **basic lease agreement PDF**, printable **blank rental agreement form**, and **commercial lease agreement form word** templates for quick signature.
            </p>
            <a href="/residential-rental-agreement" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0070f3] hover:underline">
              Simple 1-Page Lease Form →
            </a>
          </div>

        </div>
      </div>
    </section>

    <CategorySelector />
    <FAQ />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</Layout>
