---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Us & Legal Support Helpdesk | FreeRentalAgreement.com";
const pageDesc = "Get in touch with the FreeRentalAgreement.com support team for document builder assistance, technical feedback, or partnership inquiries.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />

  <main class="flex-grow bg-[#f8fafc] text-[#0f172a] py-12 md:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex text-xs text-[#64748b] mb-6 font-mono" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1e40af]">Home</a>
        <span class="mx-2">/</span>
        <span class="text-[#0f172a] font-semibold">Contact Us</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Side: Info -->
        <div class="lg:col-span-5 bg-white border border-[#e2e8f0] rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#eff6ff] text-[#1e40af] text-xs font-mono font-semibold border border-[#bfdbfe]">
            24/7 HELPDESK & SUPPORT
          </div>
          <h1 class="text-3xl font-extrabold text-[#0f172a] tracking-tight">
            We're Here to Help
          </h1>
          <p class="text-sm text-[#475569] leading-relaxed">
            Have questions about generating your legal agreement, state rent laws, or technical support? Send us a message and our team will respond within 24 hours.
          </p>

          <div class="space-y-4 pt-4 border-t border-[#e2e8f0] text-xs text-[#334155]">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#f1f5f9] text-[#1e40af] flex items-center justify-center shrink-0">
                ✉️
              </div>
              <div>
                <span class="font-bold text-[#0f172a] block">Email Support</span>
                <span class="text-[#64748b]">support@freeerentalagreement.com</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#f1f5f9] text-[#1e40af] flex items-center justify-center shrink-0">
                ⏱️
              </div>
              <div>
                <span class="font-bold text-[#0f172a] block">Response Time SLA</span>
                <span class="text-[#64748b]">Under 24 hours (Monday – Saturday)</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#f1f5f9] text-[#1e40af] flex items-center justify-center shrink-0">
                🌍
              </div>
              <div>
                <span class="font-bold text-[#0f172a] block">Global Coverage</span>
                <span class="text-[#64748b]">USA, India, UK, UAE, Canada, Australia & Europe</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Interactive Form -->
        <div class="lg:col-span-7 bg-white border border-[#e2e8f0] rounded-2xl p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-[#0f172a] mb-6 border-b border-[#e2e8f0] pb-3">
            Send Us a Support Inquiry
          </h2>

          <form id="contact-form" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received. Our support team will reply within 24 hours.');" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-[#0f172a] mb-1">Your Full Name *</label>
                <input type="text" id="contact-name" required placeholder="e.g. John Doe" class="w-full bg-[#f8fafc] text-xs text-[#0f172a] border border-[#cbd5e1] rounded-lg px-3 py-2.5 focus:border-[#1e40af] focus:outline-none" />
              </div>
              <div>
                <label for="contact-email" class="block text-xs font-semibold text-[#0f172a] mb-1">Email Address *</label>
                <input type="email" id="contact-email" required placeholder="name@example.com" class="w-full bg-[#f8fafc] text-xs text-[#0f172a] border border-[#cbd5e1] rounded-lg px-3 py-2.5 focus:border-[#1e40af] focus:outline-none" />
              </div>
            </div>

            <div>
              <label for="contact-category" class="block text-xs font-semibold text-[#0f172a] mb-1">Inquiry Category</label>
              <select id="contact-category" class="w-full bg-[#f8fafc] text-xs text-[#0f172a] border border-[#cbd5e1] rounded-lg px-3 py-2.5 focus:border-[#1e40af] focus:outline-none">
                <option value="General Question">General Platform Question</option>
                <option value="Document Builder Help">Document Builder Assistance</option>
                <option value="State Legal Preambles">State Rent Act / Statutory Question</option>
                <option value="Bug Report">Technical Issue / Bug Report</option>
                <option value="AdSense / Partnership">Partnership / Advertising Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-[#0f172a] mb-1">Your Message *</label>
              <textarea id="contact-message" rows="5" required placeholder="Describe your question or issue in detail..." class="w-full bg-[#f8fafc] text-xs text-[#0f172a] border border-[#cbd5e1] rounded-lg px-3 py-2.5 focus:border-[#1e40af] focus:outline-none"></textarea>
            </div>

            <button type="submit" class="w-full py-3 px-6 rounded-xl bg-[#1e40af] hover:bg-[#1d4ed8] text-white font-bold text-sm transition-all shadow-md active:scale-95 flex items-center justify-center gap-2">
              <span>Submit Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </form>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
