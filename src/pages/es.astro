---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategorySelector from '../components/CategorySelector.astro';
import AgreementBuilder from '../components/AgreementBuilder.astro';
import StampDutyCalculator from '../components/StampDutyCalculator.astro';
import SignatureModal from '../components/SignatureModal.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Contrato de Arrendamiento Residencial Gratis | Formulario de Alquiler en Español"
	description="Cree contratos de arrendamiento residencial y solicitudes de alquiler en español. Válido bajo la Ley de Arrendamientos Urbanos (LAU), EE.UU., España y Latinoamérica."
>
	<Header />

	<main id="main-content" class="flex-grow">
		<section class="py-12 md:py-16 bg-gradient-to-b from-[#0e0e0e] to-[#0a0a0a] border-b border-[#262626] text-center">
			<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#161616] border border-[#262626] text-xs font-mono text-[#0070f3] mb-4">
					<span>🇪🇸 PORTAL LEGAL EN ESPAÑOL • LEY DE ALQUILER</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
					Contrato de Arrendamiento Residencial en Español
				</h1>
				<p class="text-base sm:text-lg text-[#a1a1a1] max-w-3xl mx-auto leading-relaxed mb-6">
					Genere contratos de alquiler de vivienda, solicitudes de arrendamiento y acuerdos comerciales 100% legales en español. Descarga inmediata en PDF con firma digital.
				</p>
			</div>
		</section>

		<CategorySelector />
		<AgreementBuilder />
		<StampDutyCalculator />
		<FAQ />
	</main>

	<SignatureModal />
	<Footer />

	<script src="../scripts/app.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const select = document.getElementById('global-country-select') as HTMLSelectElement;
			if (select) {
				select.value = 'ES';
				select.dispatchEvent(new Event('change'));
			}
		});
	</script>
</Layout>
