---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategorySelector from '../components/CategorySelector.astro';
import AgreementBuilder from '../components/AgreementBuilder.astro';
import StampDutyCalculator from '../components/StampDutyCalculator.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Standard Residential Lease Agreement & Blank Rental Agreement Form PDF"
  description="Generate a standard residential lease agreement, blank rental agreement form, house rental agreement template, basic lease agreement PDF, landlord tenant agreement form & simple 1 page lease agreement doc online."
>
  <Header />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-12 md:py-16 bg-[#0a0a0a] border-b border-[#262626] relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#181818] border border-[#262626] text-xs font-mono text-[#0070f3] mb-4">
          <span>CATEGORY • RESIDENTIAL RENTAL AGREEMENT FORMS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 max-w-4xl mx-auto">
          Standard Residential Lease Agreement & Printable Form
        </h1>
        <p class="text-base sm:text-lg text-[#a1a1a1] max-w-3xl mx-auto leading-relaxed mb-8">
          Free printable rental lease agreement form PDF & simple 1 page lease agreement doc. Download a blank rental agreement form or custom house rental agreement template in 5 minutes.
        </p>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="#builder-section" class="px-6 py-3 rounded-xl bg-white text-black font-semibold text-sm hover:bg-[#e0e0e0] transition-colors shadow-lg flex items-center gap-2">
            Create Free Lease Agreement PDF →
          </a>
          <a href="/calculator" class="px-6 py-3 rounded-xl bg-[#181818] text-white font-medium text-sm border border-[#262626] hover:bg-[#222222] transition-colors flex items-center gap-2">
            Calculate Stamp Duty & Deposit →
          </a>
        </div>
      </div>
    </section>

    <!-- Key Keyword Features Checklist -->
    <section class="py-10 bg-[#0c0c0c] border-b border-[#262626]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-white text-center mb-6">Supported Lease Document Formats & Options</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">Standard Residential Lease Agreement</h3>
            <p class="text-xs text-[#a1a1a1]">Comprehensive 12-month or 11-month lease deed with landlord & tenant duties.</p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">Blank Rental Agreement Form</h3>
            <p class="text-xs text-[#a1a1a1]">Fill-in-the-blank property rental contract canvas with instant digital preview.</p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">House Rental Agreement Template</h3>
            <p class="text-xs text-[#a1a1a1]">Tailored for single family homes, independent villas, apartments, and flats.</p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">Basic Lease Agreement PDF</h3>
            <p class="text-xs text-[#a1a1a1]">1-click PDF download with large DRAFT stamp paper watermark placeholder.</p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">Landlord Tenant Agreement Form</h3>
            <p class="text-xs text-[#a1a1a1]">Includes notice period, security deposit refund, repair, and utility terms.</p>
          </div>
          <div class="bg-[#141414] border border-[#262626] rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-1">Simple 1 Page Lease Agreement Doc</h3>
            <p class="text-xs text-[#a1a1a1]">Short-form rental contract for rooms, PG, and quick tenant agreements.</p>
          </div>
        </div>
      </div>
    </section>

    <CategorySelector />

    <div id="category-builder-wrapper" data-default-category="residential">
      <AgreementBuilder />
    </div>

    <StampDutyCalculator />
    <FAQ />
  </main>

  <Footer />
  <script src="../scripts/app.js"></script>
</Layout>
