---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategorySelector from '../components/CategorySelector.astro';
import AgreementBuilder from '../components/AgreementBuilder.astro';
import StampDutyCalculator from '../components/StampDutyCalculator.astro';
import SignatureModal from '../components/SignatureModal.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Free Rental Agreement California, Texas, Florida & NY | Free Residential Lease Agreement Template"
	description="Generate free rental agreement California forms, California month-to-month rental agreement templates, Texas residential lease PDF, Florida landlord-tenant agreement forms, and NY standard lease drafts online."
>
	<Header />

	<main id="main-content" class="flex-grow">
		<!-- USA Portal Hero Banner -->
		<section class="py-12 md:py-16 bg-gradient-to-b from-[#0e0e0e] to-[#0a0a0a] border-b border-[#262626] text-center">
			<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#161616] border border-[#262626] text-xs font-mono text-[#0070f3] mb-4">
					<span>🇺🇸 USA LEGAL PORTAL • 50-STATE COMPLIANT</span>
				</div>
				<h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
					Free Residential Lease Agreement Template (USA)
				</h1>
				<p class="text-base sm:text-lg text-[#a1a1a1] max-w-3xl mx-auto leading-relaxed mb-6">
					Generate 100% compliant state lease agreements for California, Texas, Florida, New York, and all 50 US States. Includes lead-based paint disclosures, security deposit caps, and month-to-month rules.
				</p>
			</div>
		</section>

		<!-- US State Featured Keywords Cards -->
		<section class="py-10 bg-[#0c0c0c] border-b border-[#262626]">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-xl font-bold text-white mb-6 text-center">Featured State Rental Agreement Forms</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					<!-- California -->
					<div class="bg-[#141414] border border-[#262626] rounded-xl p-5 hover:border-[#0070f3] transition-colors">
						<div class="text-xs font-mono text-[#0070f3] uppercase tracking-wider mb-2">CALIFORNIA (CA)</div>
						<h3 class="text-sm font-bold text-white mb-1">Free Rental Agreement California</h3>
						<p class="text-xs text-[#a1a1a1] leading-relaxed mb-3">
							Includes **California month to month rental agreement template** & fixed leases under AB 12 2x rent deposit limit & Civil Code 1940.
						</p>
						<a href="#builder-section" class="text-xs font-semibold text-white hover:underline">Build CA Lease →</a>
					</div>

					<!-- Texas -->
					<div class="bg-[#141414] border border-[#262626] rounded-xl p-5 hover:border-[#50e3c2] transition-colors">
						<div class="text-xs font-mono text-[#50e3c2] uppercase tracking-wider mb-2">TEXAS (TX)</div>
						<h3 class="text-sm font-bold text-white mb-1">Texas Residential Lease Agreement PDF</h3>
						<p class="text-xs text-[#a1a1a1] leading-relaxed mb-3">
							Compliant with Texas Property Code Title 8. Includes 30-day notice provisions and landlord right of entry terms.
						</p>
						<a href="#builder-section" class="text-xs font-semibold text-white hover:underline">Build Texas Lease →</a>
					</div>

					<!-- Florida -->
					<div class="bg-[#141414] border border-[#262626] rounded-xl p-5 hover:border-[#f5a623] transition-colors">
						<div class="text-xs font-mono text-[#f5a623] uppercase tracking-wider mb-2">FLORIDA (FL)</div>
						<h3 class="text-sm font-bold text-white mb-1">Florida Landlord Tenant Agreement Form</h3>
						<p class="text-xs text-[#a1a1a1] leading-relaxed mb-3">
							Compliant with Florida Statutes Chapter 83 Part II. Includes 15-day notice terms and security deposit interest rules.
						</p>
						<a href="#builder-section" class="text-xs font-semibold text-white hover:underline">Build Florida Lease →</a>
					</div>

					<!-- New York -->
					<div class="bg-[#141414] border border-[#262626] rounded-xl p-5 hover:border-[#eb367f] transition-colors">
						<div class="text-xs font-mono text-[#eb367f] uppercase tracking-wider mb-2">NEW YORK (NY)</div>
						<h3 class="text-sm font-bold text-white mb-1">New York Standard Residential Lease Draft</h3>
						<p class="text-xs text-[#a1a1a1] leading-relaxed mb-3">
							Compliant with NY Real Property Law Art. 7 & HSTPA tenant protection laws with window guard & lead paint disclosures.
						</p>
						<a href="#builder-section" class="text-xs font-semibold text-white hover:underline">Build NY Lease →</a>
					</div>
				</div>
			</div>
		</section>

		<CategorySelector />
		<AgreementBuilder />
		<StampDutyCalculator />
		<FAQ />
	</main>

	<SignatureModal />
	<Footer />

	<script src="../scripts/app.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const select = document.getElementById('global-country-select') as HTMLSelectElement;
			if (select) {
				select.value = 'US';
				select.dispatchEvent(new Event('change'));
			}
		});
	</script>
</Layout>
